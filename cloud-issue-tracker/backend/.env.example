# Copy this file to .env and adjust the values for your machine
PORT=3000
NODE_ENV=development

# Neon connection string (Neon Console → Connect). Never commit the real value.
DATABASE_URL=postgresql:postgresql://neondb_owner:npg_smcM8TfnXHB5@ep-tiny-smoke-akdfquc8-pooler.c-3.us-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

